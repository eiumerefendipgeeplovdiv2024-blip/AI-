import numpy as np

# 1. Activation Functions & Their Derivatives
def sigmoid(x):
    return 1 / (1 + np.exp(-x))

def sigmoid_derivative(x):
    # x is already the output of sigmoid(z)
    return x * (1 - x)

# 2. Input Dataset (XOR Truth Table)
# 4 samples, 2 features each
X = np.array([[0, 0],
,
 ,
              [1, 1]])

# Target Outputs (XOR results)
y = np.array([[0], , 
, 
              [0]])

# 3. Network Architecture & Hyperparameters
input_size = 2
hidden_size = 3   # 3 neurons in the hidden layer
output_size = 1
learning_rate = 0.1
epochs = 20000    # Number of training loops

# Seed random numbers for reproducibility
np.random.seed(42)

# Initialize Weights and Biases randomly
weights_hidden = np.random.uniform(size=(input_size, hidden_size))
bias_hidden = np.random.zeros((1, hidden_size))

weights_output = np.random.uniform(size=(hidden_size, output_size))
bias_output = np.random.zeros((1, output_size))

print("--- Training Started ---")

# 4. The Training Loop
for epoch in range(epochs):
    
    # --- FORWARD PROPAGATION ---
    # Layer 1 (Hidden Layer)
    hidden_activation = np.dot(X, weights_hidden) + bias_hidden
    hidden_output = sigmoid(hidden_activation)
    
    # Layer 2 (Output Layer)
    output_activation = np.dot(hidden_output, weights_output) + bias_output
    predicted_output = sigmoid(output_activation)
    
    # --- CALCULATE LOSS (Mean Squared Error) ---
    error = y - predicted_output
    loss = np.mean(error ** 2)
    
    # Print progress every 4000 steps
    if epoch % 4000 == 0:
        print(f"Epoch {epoch:5d} | Loss: {loss:.6f}")
        
    # --- BACKWARD PROPAGATION ---
    # How much did the output layer contribute to the error?
    d_predicted_output = error * sigmoid_derivative(predicted_output)
    
    # How much did the hidden layer contribute to the error?
    error_hidden_layer = d_predicted_output.dot(weights_output.T)
    d_hidden_output = error_hidden_layer * sigmoid_derivative(hidden_output)
    
    # --- UPDATE WEIGHTS & BIASES (Gradient Descent) ---
    weights_output += hidden_output.T.dot(d_predicted_output) * learning_rate
    bias_output += np.sum(d_predicted_output, axis=0, keepdims=True) * learning_rate
    
    weights_hidden += X.T.dot(d_hidden_output) * learning_rate
    bias_hidden += np.sum(d_hidden_output, axis=0, keepdims=True) * learning_rate

print("\n--- Training Complete ---")
print("\nFinal Predictions vs Targets:")
for i in range(len(X)):
    print(f"Input: {X[i]} -> Predicted: {predicted_output[i][0]:.4f} (Target: {y[i][0]})")
